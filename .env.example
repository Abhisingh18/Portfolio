# All optional. Without these the contact form falls back to opening the
# visitor's mail client with the message pre-filled.

# https://resend.com — API key for delivering contact messages to an inbox.
RESEND_API_KEY=

# Where messages are delivered. Defaults to the address in content/site.ts.
CONTACT_TO=

# Sender shown on the email. Needs a domain verified with Resend;
# defaults to Resend's shared onboarding sender.
CONTACT_FROM=
